APP_NAME=FamilyHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://familyhub.example.com
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=familyhub
DB_USERNAME=familyhub
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=familyhub.example.com
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=familyhub

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@familyhub.example.com
MAIL_FROM_NAME=FamilyHub

AWS_ACCESS_KEY_ID=familyhub
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=familyhub-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
DOCUMENT_QUARANTINE_PREFIX=quarantine
DOCUMENT_RELEASED_PREFIX=released

ANTIVIRUS_DRIVER=clamav
ANTIVIRUS_FAIL_CLOSED=true
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=20

AUTH_TOKEN_TTL_MINUTES=480
SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=familyhub.example.com

MINIO_ROOT_USER=familyhub
MINIO_ROOT_PASSWORD=change-me-minio
POSTGRES_DB=familyhub
POSTGRES_USER=familyhub
POSTGRES_PASSWORD=change-me

VITE_API_URL=/api
VITE_CITY_MAP_PROVIDER=osm
VITE_MAPTILER_KEY=
