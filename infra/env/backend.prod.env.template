# FamilyHub production environment template
# Copiare questo file in `.env.prod` sul server remoto e sostituire tutti i valori `CHANGE_ME`.
# Non committare mai il file `.env.prod` reale con segreti veri.

APP_NAME=FamilyHub
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATED_APP_KEY
APP_DEBUG=false
APP_URL=https://app.familyhub.example
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=familyhub_prod
DB_USERNAME=familyhub_prod
DB_PASSWORD=CHANGE_ME_DB_PASSWORD_LONG_RANDOM

SESSION_DRIVER=redis
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=app.familyhub.example
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=familyhub_prod

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@app.familyhub.example
MAIL_FROM_NAME=FamilyHub

AWS_ACCESS_KEY_ID=familyhub_prod
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_OR_S3_SECRET
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=familyhub-prod-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,video/mp4,application/msword,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
DOCUMENT_QUARANTINE_PREFIX=quarantine
DOCUMENT_RELEASED_PREFIX=released
STAFF_DOCUMENT_EXPIRY_ALERT_DAYS=30

ANTIVIRUS_DRIVER=clamav
ANTIVIRUS_FAIL_CLOSED=true
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=20

AUTH_TOKEN_TTL_MINUTES=480
SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=app.familyhub.example

MINIO_ROOT_USER=familyhub_prod
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD_LONG_RANDOM
POSTGRES_DB=familyhub_prod
POSTGRES_USER=familyhub_prod
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD_LONG_RANDOM

VITE_API_URL=/api
VITE_CITY_MAP_PROVIDER=osm
VITE_MAPTILER_KEY=
