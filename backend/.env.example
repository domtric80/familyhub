APP_NAME=FamilyHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=familyhub
DB_USERNAME=familyhub
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=familyhub

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=familyhub
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=familyhub-private
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

DOCUMENT_MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
DOCUMENT_QUARANTINE_PREFIX=quarantine
DOCUMENT_RELEASED_PREFIX=released

ANTIVIRUS_DRIVER=clamav
ANTIVIRUS_FAIL_CLOSED=true
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_SECONDS=20

BOOTSTRAP_ADMIN_EMAIL=admin@familyhub.local
BOOTSTRAP_ADMIN_PASSWORD=password
AUTH_TOKEN_TTL_MINUTES=30
SANCTUM_EXPIRATION=30

VITE_APP_NAME="${APP_NAME}"

GEOGRAPHY_SOURCE_DISK=local
GEOGRAPHY_ISTAT_DELIMITER=;
GEOGRAPHY_ISTAT_MODE=remote_file
GEOGRAPHY_ISTAT_FORMAT=csv
GEOGRAPHY_ISTAT_SOURCE_PATH=
GEOGRAPHY_ISTAT_SOURCE_URL=https://www.istat.it/storage/codici-unita-amministrative/Elenco-comuni-italiani.csv
GEOGRAPHY_GEONAMES_COUNTRIES_URL=https://download.geonames.org/export/dump/countryInfo.txt
GEOGRAPHY_GEONAMES_ADMIN1_URL=https://download.geonames.org/export/dump/admin1CodesASCII.txt
GEOGRAPHY_GEONAMES_ADMIN2_URL=https://download.geonames.org/export/dump/admin2Codes.txt
GEOGRAPHY_GEONAMES_COUNTRY_DUMP_URL_TEMPLATE=https://download.geonames.org/export/dump/{ISO}.zip

